datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String    // "PATIENT" | "DOCTOR"
  name         String
  phone        String?
  bloodGroup   String?
  allergies    String?
  dob          DateTime?
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  doctorProfile DoctorProfile?
  appointments  Appointment[]   @relation("PatientAppointments")
  followUps     FollowUp[]      @relation("PatientFollowUps")
}

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  qualification  String?
  experienceYears Int     @default(0)
  consultationFee Float    @default(500)
  bio             String?
  photoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  slots        Slot[]
  appointments Appointment[]
  followUps    FollowUp[]
}

model Slot {
  id          String        @id @default(uuid())
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek   String        // "Monday", "Tuesday", etc.
  startTime   String        // "09:00"
  endTime     String        // "10:00"
  isAvailable Boolean       @default(true)
  createdAt   DateTime      @default(now())

  // Relations
  appointments Appointment[]

  @@unique([doctorId, dayOfWeek, startTime], name: "doctor_slot_unique")
}

model Appointment {
  id              String        @id @default(uuid())
  patientId       String
  patient         User          @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slotId          String?
  slot            Slot?         @relation(fields: [slotId], references: [id], onDelete: SetNull)
  appointmentDate DateTime
  timeSlot        String        // e.g. "09:00 - 10:00"
  amount          Float
  status          String        @default("PENDING")  // "PENDING" | "CONFIRMED" | "CANCELLED" | "COMPLETED"
  paymentStatus   String        @default("PENDING")  // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  symptoms        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  payment  Payment?
  followUp FollowUp?
}

model Payment {
  id                String      @id @default(uuid())
  appointmentId     String      @unique
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Float
  currency          String      @default("INR")
  status            String      @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model FollowUp {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User          @relation("PatientFollowUps", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  notes         String
  prescription  Json?         // Array of { medicineName, dosage, duration }
  followUpDate  DateTime?
  status        String        @default("ACTIVE") // "ACTIVE" | "INVALIDATED"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
